# Ista Postgres baza koju koristi n8n (Railway -> Postgres servis -> Variables -> DATABASE_PUBLIC_URL,
# ili bolje: u Railway-u referenciraj Postgres servis promenljivu direktno, ne kopiraj rucno)
DATABASE_URL=postgresql://user:password@host:port/railway

# Bilo koji dugacak nasumican string, koristi se za potpisivanje login sesije.
# Generisi ga npr. komandom: openssl rand -base64 32
JWT_SECRET=

# n8n instant-send webhook — "Posalji podsetnik" dugme odmah salje WhatsApp
# poruku umesto da ceka sledecu automatsku proveru. Ako ove dve nisu podesene,
# dugme se vraca na stari (odlozeni) nacin rada.
N8N_INSTANT_WEBHOOK_URL=https://servicetest.app.n8n.cloud/webhook/f7009fd7-626b-44ce-a086-6968664478b5
N8N_INSTANT_WEBHOOK_SECRET=dab87da3d4b8476c1d2f6b9b537146c30f62d37785b17727

# Admin panel (/admin/novi-biznis) za dodavanje novih biznisa — Basic Auth.
# Bez ovih, admin rute su zakljucane (503).
ADMIN_USER=
ADMIN_PASSWORD=
